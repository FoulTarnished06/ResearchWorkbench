# AI Research Workbench v3.0 — Environment Variables Template
# Copy this file to .env and insert your real API keys.

# Google Gemini API Key (Gemini 3.8 Flash, 3.6 Flash, 3.5 Flash, 3.1 Pro)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Anthropic API Key (Claude Opus 5.5, Claude Sonnet 5.5, Claude Haiku)
# Get your key at: https://console.anthropic.com/
# Strict token ceilings enforced: Opus 4096 tokens, Sonnet/Haiku 8192 tokens
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (GPT-6 & GPT-5 generation models: gpt-6.1-sol, gpt-6-sol, gpt-6-luna, gpt-6-astra, gpt-5.5, gpt-5.4, gpt-5.4-mini)
# Get your key at: https://platform.openai.com/api-keys
# Uses native asynchronous HTTP client (httpx) with zero extra pip package dependencies
OPENAI_API_KEY=your_openai_api_key_here

# Optional: SerpAPI Key for Google Scholar fallback (not required; 6 academic repos are free)
SERPAPI_API_KEY=your_serpapi_key_here

# Cloud Database (100% Free Cloud PostgreSQL — Neon, Supabase, Render, Aiven)
# Leave blank to use local SQLite, or paste your free cloud database connection string:
# Option 1: Neon Serverless PostgreSQL (Instant & Free forever): https://neon.tech
# Option 2: Supabase PostgreSQL (Free forever): https://supabase.com
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Session Security (AUTH-01 & Per-User AES-256-GCM Vault)
# Generate a random 32-character secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_jwt_secret_key_minimum_32_chars

# Third-Party Social OAuth 2.0 (Optional — for Google & GitHub Single Sign-On)
# Google OAuth 2.0 (Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# GitHub OAuth App (Developer Settings: https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Base application URL (Optional: defaults to request origin e.g. http://localhost:8000)
APP_BASE_URL=http://localhost:8000

# Application Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
RELOAD=false
LOG_LEVEL=INFO

# Production CORS Security (Allowed origins or regex for cloud platforms)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_ORIGIN_REGEX=https?://.*

# Network & Timeout Configurations (in seconds)
SCRAPER_HTTP_TIMEOUT=8.0
CITATION_HTTP_TIMEOUT=5.0

